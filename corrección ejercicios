# 36. Clase UsuarioBanco: nombre, saldo, cuenta corriente y operaciones. [cite: 71, 72, 74, 75, 77, 79]
class UsuarioBanco:
    def __init__(self, nombre: str, saldo: float, tiene_cc: bool):
        self.nombre = nombre
        self.saldo = saldo
        self.tiene_cc = tiene_cc

    def agregar_dinero(self, cantidad: float):
        self.saldo += cantidad

    def retirar_dinero(self, cantidad: float):
        if cantidad > self.saldo:
            raise ValueError(f"Saldo insuficiente para {self.nombre}")
        self.saldo -= cantidad

    def transferir_dinero(self, emisor: 'UsuarioBanco', cantidad: float):
        emisor.retirar_dinero(cantidad)
        self.agregar_dinero(cantidad)

# --- CASO DE USO ---
alicia = UsuarioBanco("Alicia", 100, True)
bob = UsuarioBanco("Bob", 50, True)

bob.agregar_dinero(20)

try:
